# Copy to .env and adjust for local/docker

POSTGRES_USER=cyberapp
POSTGRES_PASSWORD=cyberapp_secret_change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Adminer — веб-UI для PostgreSQL (только для разработки; в прод не выставляйте в интернет)
ADMINER_PORT=5050
ADMINER_DESIGN=rmsoft_blue-dark

REDIS_URL=redis://redis:6379/0

JWT_SECRET=change-this-min-32-chars-secret-key-prod
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

AUTH_SERVICE_URL=http://auth-service:8000
SIMULATION_SERVICE_URL=http://simulation-service:8000
PROGRESS_SERVICE_URL=http://progress-service:8000

GATEWAY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
