# Базовый URL бекенда для клиентских запросов (без завершающего /).
# В dev без переменной используется локальный mock (localStorage).
# В Docker-сборке можно оставить пустым: запросы /api проксируются через nginx фронта.
VITE_API_URL=

# Порты compose (опционально). Фронт по умолчанию 3173 — не :3000
FRONTEND_PORT=3173
CIPHERLINE_PORT=3173
BACKEND_PORT=8080
